# 约稿工作流环境变量示例

# JWT 密钥（生产环境必须修改！）
SECRET_KEY=byd-workflow-secret-key-change-in-production

# 数据库路径
WORKFLOW_RUNTIME_DIR=runtime/
WORKFLOW_OUTPUT_DIR=output/
WORKFLOW_TABLE_DIR=table/

# 服务器配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS 允许的前端地址
FRONTEND_URL=http://localhost:5173

# 日志级别
LOG_LEVEL=INFO

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
